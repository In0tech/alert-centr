def close_notifications(current_sbh):
    global CURRENT_OPEN_NOTIFICATIONS
    remove_ranges = []    

    for target_range in CURRENT_OPEN_NOTIFICATIONS.keys():
        if target_range not in current_sbh:
            #genie_event_id = CURRENT_OPEN_NOTIFICATIONS[target_range]['genie_event_id']
            #genie_event: pd.DataFrame = get_genie_event_by_id(genie_event_id)
            
            #if genie_event.empty:
            #    print(f"Genie event {genie_event_id} not found")
            #    exit(1)
            
            #genie_event_text = get_genie_events_closed_text(genie_event.iloc[0])
            
            print(f'Sending close <<<<<<< for {target_range}')
            genie_event_text = f"✅ Митигация окончена {target_range_to_cidr(*target_range)} "
            send_notification(buzz_url, genie_info_bot_token, buzz_csirt_chat_id, genie_event_text, CURRENT_OPEN_NOTIFICATIONS[target_range]['sync_id'])
            remove_ranges.append(target_range)
            
    for range in remove_ranges:
        del CURRENT_OPEN_NOTIFICATIONS[target_range]
                
                

